  "cards": [
    {
      "dot": "emerald",
      "title": "Why --fast is fast",
      "items": [
        "Repo list still comes from GitHub",
        "Commit and README details are reused from cache",
        "No per-repo README API loop runs"
      ]
    },
    {
      "dot": "violet",
      "title": "Graph semantics",
      "items": [
        "Links are similarity edges",
        "They are not import or dependency edges",
        "Each node is capped to five rendered links"
      ]
    },
    {
      "dot": "orange",
      "title": "Runtime boundary",
      "items": [
        "After HTML generation, the app is static",
